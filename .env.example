# ==============================================================================
# AdaptiveShield Environment Configuration Template
# Copy this file to .env and populate with client-specific secrets.
# Do NOT commit your actual .env file to Git!
# ==============================================================================

# LLM Honeypot Generation (Google Gemini API Key for Galah Honeypot)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to custom company profile JSON (defaults to config/company_profile.json or runtime/company_profile.json)
# COMPANY_PROFILE_PATH=/app/runtime/company_profile.json

# Optional: Local Ollama URL if running in air-gapped / offline environment
# OLLAMA_URL=http://localhost:11434
